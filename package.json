{
  "name": "@duke-dsh-plugins/dsh-memory-manager",
  "version": "1.4.1",
  "description": "Persistent project memory for DeepSeek Harness, ported from ZCode: ZCode-style markdown memory store (per project + global) with a full memory-management page in Settings, index-first prompt injection, agent memory tools (memory_save / memory_get / memory_list), plus one-click import from an existing ZCode memory directory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-memory-manager.git"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-memory-manager",
  "bugs": { "url": "https://github.com/MoonlitDropOfBlood/dsh-memory-manager/issues" },
  "publishConfig": { "access": "public" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "memory"],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "memory-core.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "^0.1.0-rc.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check typert.host.js && node --check memory-core.mjs && node --check scripts/self-test.mjs && node --check scripts/test-typert-contract.mjs",
    "test": "node scripts/self-test.mjs && node scripts/test-typert-contract.mjs"
  }
}
